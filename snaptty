#!/usr/bin/env bash
# snaptty: paste macOS screenshots into the terminal with Cmd+V.
#
# Installs a LaunchAgent running snaptty.app (built from src/), which puts every new
# screenshot on the clipboard as its file path (plus the PNG data), wherever
# macOS saves it, and does the same for image-only clipboard content.
#
#   snaptty install [--no-clipboard]   build the app and start the agent
#   snaptty uninstall                  stop the agent and remove its files
set -euo pipefail

label="com.s3rgiosan.snaptty"
support_dir="$HOME/Library/Application Support/snaptty"
cache_dir="$HOME/Library/Caches/snaptty"
log_file="$HOME/Library/Logs/snaptty.log"
plist="$HOME/Library/LaunchAgents/${label}.plist"
app_dir="${support_dir}/snaptty.app"
agent_bin="${app_dir}/Contents/MacOS/snaptty"
build_hash="${support_dir}/build.sha256"
source_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
build_inputs=(
  "${source_dir}/src/snaptty-agent.swift"
  "${source_dir}/src/Info.plist"
  "${source_dir}/assets/snaptty.icns"
)

# The agent runs as an app bundle so Login Items and the folder access prompt
# show its name and icon. macOS ties folder access (Desktop, Documents,
# Downloads) to the exact build, so the app is rebuilt only when its inputs
# change.
build_app() {
  local inputs_hash current_hash
  inputs_hash="$(cat "${build_inputs[@]}" | shasum -a 256 | cut -d' ' -f1)"
  current_hash="$(cat "$build_hash" 2>/dev/null || true)"

  if [ -x "$agent_bin" ] && [ "$current_hash" = "$inputs_hash" ]; then
    echo "app up to date: ${app_dir}"
    return
  fi

  rm -rf "$app_dir"
  mkdir -p "${app_dir}/Contents/MacOS" "${app_dir}/Contents/Resources"
  swiftc -O "${source_dir}/src/snaptty-agent.swift" -o "$agent_bin"
  cp "${source_dir}/src/Info.plist" "${app_dir}/Contents/Info.plist"
  cp "${source_dir}/assets/snaptty.icns" "${app_dir}/Contents/Resources/snaptty.icns"
  codesign --force --sign - "$app_dir"

  printf '%s' "$inputs_hash" > "$build_hash"
  echo "app built: ${app_dir}"
}

write_plist() {
  local arg args=""
  for arg in "$@"; do
    args+="    <string>${arg}</string>"$'\n'
  done

  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>
  <key>ProgramArguments</key>
  <array>
${args}  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>${label}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>${log_file}</string>
  <key>StandardErrorPath</key>
  <string>${log_file}</string>
</dict>
</plist>
PLIST
}

install() {
  local agent_args=("$agent_bin" "$cache_dir")

  case "${1:-}" in
    --no-clipboard) agent_args+=(--no-clipboard) ;;
    "") ;;
    *)
      echo "unknown option: $1" >&2
      exit 1
      ;;
  esac

  mkdir -p "$support_dir" "$cache_dir" "$(dirname "$plist")" "$(dirname "$log_file")"
  build_app
  write_plist "${agent_args[@]}"

  launchctl bootout "gui/$(id -u)/${label}" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"

  echo "agent loaded: ${plist}"
  echo "log: ${log_file}"
}

uninstall() {
  launchctl bootout "gui/$(id -u)/${label}" 2>/dev/null || true
  rm -f "$plist"
  rm -rf "$support_dir" "$cache_dir"

  echo "agent removed; ${log_file} was left in place"
}

case "${1:-}" in
  install) install "${2:-}" ;;
  uninstall) uninstall ;;
  *)
    echo "usage: $(basename "$0") install [--no-clipboard] | uninstall" >&2
    exit 1
    ;;
esac
